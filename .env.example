# GoFlow configuration. Copy to .env and adjust; every value below is the
# built-in default, so an unchanged copy behaves exactly like having no .env.
# Real environment variables always take precedence over this file.

# Port the HTTP server listens on.
PORT=8080

# SQLite database file (created on startup, along with migrations).
DATABASE_PATH=./data/goflow.db

# Initial (and minimum) worker count.
WORKER_COUNT=2

# Internal job-queue buffer capacity.
QUEUE_SIZE=100

# Automatic retries before a job is marked DEAD.
MAX_RETRIES=3

# Default per-job execution timeout, in seconds.
DEFAULT_JOB_TIMEOUT_SECONDS=30

# Graceful-shutdown budget, in seconds (note: no _SECONDS suffix).
SHUTDOWN_TIMEOUT=15

# How often the scheduler promotes due SCHEDULED jobs, in seconds.
SCHEDULER_POLL_INTERVAL_SECONDS=2

# How often the worker pool re-evaluates its size, in seconds.
SCALING_CHECK_INTERVAL_SECONDS=3

# Priority aging tick, in seconds: waiting jobs are boosted one level per
# tick. Set to 0 to disable aging.
AGING_INTERVAL_SECONDS=60

# Worker heartbeat interval, in seconds.
HEARTBEAT_INTERVAL_SECONDS=5

# A worker with no heartbeat for this long is considered stale, in seconds.
STALE_WORKER_THRESHOLD_SECONDS=20

# Queue-size to worker-count rules, ascending: "maxQueue:workers,...".
SCALING_THRESHOLDS=10:2,50:5,999999:10

# Per-job-type concurrency caps: "type=maxConcurrent,..." (empty = every
# type unlimited). A job of a capped type waits for a free slot after being
# claimed; the wait is bounded by the job's own timeout and counts as part
# of the attempt. Example: JOB_TYPE_LIMITS=image_processing=2,email_sending=5
JOB_TYPE_LIMITS=
